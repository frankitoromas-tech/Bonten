# =================================================================
#  VARIABLES DE ENTORNO — BONTEN DEFENSE & CONFIGURACIÓN
#  Copie este archivo a .env.local y defina credenciales seguras.
# =================================================================

# Superadmin soberano inicial de BONTEN
ADMIN_USER=fireboy
ADMIN_PASS=

# Secretos criptográficos para firma HMAC-SHA256 (mínimo 32 caracteres)
ADMIN_JWT_SECRET=
COMMUNITY_JWT_SECRET=

# Clave de integración segura para ingesta doctrinal externa (mínimo 32 caracteres)
LUYO_INGEST_KEY=

# Confianza en proxies perimetrales (Vercel / Cloudflare / Nginx)
TRUST_PROXY_HEADERS=true
